#!/bin/sh
# Pre-commit hook — three checks in order:
#   1. detect-secrets  — blocks credential leaks
#   2. lint-staged     — ESLint --fix on staged .ts/.tsx files
#   3. tsc --noEmit    — full TypeScript type check

staged_files=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$staged_files" ]; then
  exit 0
fi

# ── 1. Secret scanning ────────────────────────────────────────────────────────
echo "$staged_files" | xargs python -m detect_secrets.pre_commit_hook --baseline .secrets.baseline
if [ $? -ne 0 ]; then
  echo ""
  echo "⛔  detect-secrets blocked this commit: potential secret(s) detected."
  echo ""
  echo "   To review what was flagged:"
  echo "     python -m detect_secrets audit .secrets.baseline"
  echo ""
  echo "   If the finding is a false positive, mark it as safe in the audit,"
  echo "   then regenerate the baseline:"
  echo "     python -m detect_secrets scan > .secrets.baseline"
  echo "     git add .secrets.baseline"
  echo ""
  exit 1
fi

# ── 2. ESLint (auto-fix staged TS/TSX files) ──────────────────────────────────
npx lint-staged
if [ $? -ne 0 ]; then
  echo ""
  echo "⛔  ESLint found errors that could not be auto-fixed."
  echo "   Fix the issues above, then re-stage and commit."
  echo ""
  exit 1
fi

# ── 3. TypeScript type check ──────────────────────────────────────────────────
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo ""
  echo "⛔  TypeScript type errors found. Fix them before committing."
  echo ""
  exit 1
fi
