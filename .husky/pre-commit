#!/bin/sh
# detect-secrets pre-commit hook
# Scans staged files for API keys, tokens, and credentials.
# Blocks the commit if new unvetted secrets are found.

staged_files=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$staged_files" ]; then
  exit 0
fi

echo "$staged_files" | xargs python -m detect_secrets.pre_commit_hook --baseline .secrets.baseline
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "⛔  detect-secrets blocked this commit: potential secret(s) detected."
  echo ""
  echo "   To review what was flagged:"
  echo "     python -m detect_secrets audit .secrets.baseline"
  echo ""
  echo "   If the finding is a false positive, mark it as safe in the audit,"
  echo "   then regenerate the baseline:"
  echo "     python -m detect_secrets scan > .secrets.baseline"
  echo "     git add .secrets.baseline"
  echo ""
  exit 1
fi
