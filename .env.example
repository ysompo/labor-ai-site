# ============================================================
# .env.example — copy to .env.local and fill in real values
# NEVER commit .env.local or any file with real credentials
# ============================================================

# ---- Auth / Session ----------------------------------------
AUTH_SECRET=your-auth-secret-here
CRON_SECRET=your-cron-secret-here

# ---- AI / LLM APIs -----------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...

# ---- Email (Resend) ----------------------------------------
RESEND_API_KEY=re_...

# ---- Google OAuth + Calendar -------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
GOOGLE_CALENDAR_ID=primary

# ---- Microsoft OAuth + Graph API ---------------------------
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=your-microsoft-tenant-id
MICROSOFT_REFRESH_TOKEN=your-microsoft-refresh-token
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# ---- Zoom (Server-to-Server OAuth) -------------------------
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
ZOOM_USER_EMAIL=your-zoom-user@example.com

# ---- WhatsApp Business API ---------------------------------
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_TOKEN=your-whatsapp-api-token
WHATSAPP_VERIFY_TOKEN=your-whatsapp-webhook-verify-token
META_APP_SECRET=your-meta-app-secret
OWNER_PHONE=972500000000

# ---- Database (PostgreSQL / Neon / Vercel Postgres) --------
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require
POSTGRES_URL_NON_POOLING=postgres://user:password@host/dbname?sslmode=require
POSTGRES_PRISMA_URL=postgres://user:password@host/dbname?sslmode=require&pgbouncer=true
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ---- Pusher (Real-time) ------------------------------------
PUSHER_APP_ID=your-pusher-app-id
PUSHER_KEY=your-pusher-key
PUSHER_SECRET=your-pusher-secret
PUSHER_CLUSTER=eu
NEXT_PUBLIC_PUSHER_KEY=your-pusher-key
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# ---- Vercel Blob Storage -----------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ---- Application Config ------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RESEARCH_ASSISTANT_MODEL=claude-sonnet-4-6
NODE_ENV=development
PORT=3000

# ---- WhatsApp Bot (Whatsapp_bot/bot/) ----------------------
# Also see Whatsapp_bot/bot/.env.example for bot-specific vars
QR_SECRET=your-qr-secret-here
KV_REST_API_URL=https://your-kv-url.kv.vercel-storage.com
KV_REST_API_TOKEN=your-kv-rest-api-token
