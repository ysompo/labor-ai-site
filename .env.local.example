# Journal Club Environment Variables
# Copy this file to .env.local and fill in the required values with your actual secrets
# NOTE: This file contains template/example values only and is safe to commit
# pragma: allowlist secret

# Database
# Required: PostgreSQL database URL for storing journals, articles, and settings
POSTGRES_URL=postgresql://user:password@host:5432/database

# Authentication
# Required: Secret key for JWT token signing (generate with: openssl rand -hex 32)
# pragma: allowlist secret
JWT_SECRET=your-secret-key-here

# Required: Encryption key for storing sensitive credentials (generate with: openssl rand -hex 32)
# pragma: allowlist secret
ENCRYPTION_KEY=your-encryption-key-here

# HUJI (Hebrew University) credentials
# Required: HUJI email for institutional access
# pragma: allowlist secret
HUJI_EMAIL=your-email@huji.ac.il

# Required: HUJI password for institutional access (will be encrypted in database)
# pragma: allowlist secret
HUJI_PASSWORD=your-password-here

# Resend Email Service (optional)
# Optional: API key for sending emails via Resend
# Get from: https://resend.com/api-keys
# pragma: allowlist secret
RESEND_API_KEY=re_your_api_key_here

# Optional: Email address to send from (must be verified in Resend)
RESEND_FROM=noreply@labor-ai.org

# Email recipients (optional, can be configured via /admin/settings)
# Optional: Up to 3 email addresses for reading list notifications
EMAIL_TO_1=recipient1@example.com
EMAIL_TO_2=recipient2@example.com
EMAIL_TO_3=recipient3@example.com

# Admin configuration
# Required: Password for accessing /admin/login
# pragma: allowlist secret
ADMIN_PASSWORD=change-this-secure-password

# Chrome/Chromium configuration (for PDF downloads)
# Optional: Path to Chrome user profile directory
CHROME_PROFILE=/path/to/chrome/profile

# Optional: Path where downloaded PDFs will be stored
OUTPUT_DIR=/path/to/pdf/storage

# Deployment environment
# Required: Must be 'production', 'staging', or 'development'
NODE_ENV=development
